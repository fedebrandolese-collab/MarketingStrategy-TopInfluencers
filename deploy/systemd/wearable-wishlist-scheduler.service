# The wearable_wishlist wishlist scheduler: `python -m wearable_wishlist.ops serve` sleeps until daily_at (config/schedule.yaml, in the
# machine's local time: set TZ below on a UTC server), runs the stages that are due, and repeats. It re-reads the
# schedule every cycle. `systemctl stop` sends SIGTERM: a run in progress records its interrupted stage as failed (the
# next run redoes it) and the process exits 0.
# Paths assume the repo in /opt/wearable_wishlist, run by a `wearable_wishlist` user: edit them to match. Install: deploy/README.md.
[Unit]
Description=wearable_wishlist wishlist scheduler (python -m wearable_wishlist.ops serve)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=wearable_wishlist
WorkingDirectory=/opt/wearable_wishlist
Environment=PYTHONPATH=/opt/wearable_wishlist/src
Environment=PYTHONUNBUFFERED=1
#Environment=TZ=Europe/Rome
ExecStart=/opt/wearable_wishlist/.venv/bin/python -m wearable_wishlist.ops serve
Restart=on-failure
RestartSec=60
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
