<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent: runs scripts/refresh.sh (python -m wearable_wishlist.ops run: the stages due in config/schedule.yaml) every day
  at daily_at, local time. A Mac asleep at that time runs it when it wakes.
  __REPO__, __HOUR__ and __MINUTE__ are filled in by scripts/install_schedule.sh, the time from daily_at in
  config/schedule.yaml: after changing daily_at, run `make schedule && make schedule-on` again.
  Disabled is true on purpose: installing the file does not schedule anything (not even at the next login).
  Activate with `make schedule-on` (launchctl load -w), stop with `make schedule-off` (launchctl unload -w).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wearable-wishlist.wishlist</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/refresh.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>__HOUR__</integer>
    <key>Minute</key>
    <integer>__MINUTE__</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>Disabled</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__REPO__/data/logs/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/logs/launchd.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
